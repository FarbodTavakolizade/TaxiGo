<%- include('../partials/header') %>

<div class="card card-narrow">
  <h1>Request a Taxi</h1>
  <p class="muted">Enter where you are and where you want to go.</p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <form method="POST" action="/passenger/rides">
    <div class="form-group">
      <label for="origin">Origin</label>
      <input type="text" id="origin" name="origin" required maxlength="200"
             placeholder="e.g. Azadi Square" value="<%= form.origin || '' %>" />
    </div>
    <div class="form-group">
      <label for="destination">Destination</label>
      <input type="text" id="destination" name="destination" required maxlength="200"
             placeholder="e.g. Mehrabad Airport" value="<%= form.destination || '' %>" />
    </div>
    <div class="btn-row">
      <button type="submit" class="btn btn-primary">Request Taxi</button>
      <a class="btn" href="/passenger/rides">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
