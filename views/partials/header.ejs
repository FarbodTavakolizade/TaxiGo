<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' | Taxi System' : 'Taxi System' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="navbar">
    <div class="container nav-inner">
      <a class="brand" href="/">
        <span class="brand-mark">🚕</span>
        TaxiGo
      </a>
      <nav class="nav-links">
        <% var isActive = function (path) { return currentPath === path ? 'active' : ''; }; %>
        <% if (!currentUser) { %>
          <a class="<%= isActive('/login') %>" href="/login">Login</a>
          <a class="<%= isActive('/register') %>" href="/register">Register</a>
        <% } else { %>
          <% if (currentUser.role === 'PASSENGER') { %>
            <a class="<%= isActive('/passenger/dashboard') %>" href="/passenger/dashboard">Dashboard</a>
            <a class="<%= isActive('/passenger/rides') %>" href="/passenger/rides">My Rides</a>
            <a class="<%= isActive('/passenger/rides/new') %>" href="/passenger/rides/new">Request Taxi</a>
          <% } else if (currentUser.role === 'DRIVER') { %>
            <a class="<%= isActive('/driver/dashboard') %>" href="/driver/dashboard">Dashboard</a>
            <a class="<%= isActive('/driver/rides') %>" href="/driver/rides">My Rides</a>
          <% } else if (currentUser.role === 'ADMIN') { %>
            <a class="<%= isActive('/admin/dashboard') %>" href="/admin/dashboard">Dashboard</a>
            <a class="<%= isActive('/admin/users') %>" href="/admin/users">Users</a>
            <a class="<%= isActive('/admin/rides') %>" href="/admin/rides">Rides</a>
          <% } %>
          <span class="nav-user"><%= currentUser.name %> (<%= currentUser.role.toLowerCase() %>)</span>
          <a class="nav-logout" href="/logout">Logout</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container">
    <% if (flash.success) { %>
      <div class="flash flash-success"><%= flash.success %></div>
    <% } %>
    <% if (flash.error) { %>
      <div class="flash flash-error"><%= flash.error %></div>
    <% } %>
