<%- include('../partials/header') %>

<div class="page-header">
  <h1>Admin Dashboard</h1>
</div>

<h2>Users</h2>
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-value"><%= stats.totalUsers %></div>
    <div class="stat-label">Total users</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.totalDrivers %></div>
    <div class="stat-label">Drivers</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.totalPassengers %></div>
    <div class="stat-label">Passengers</div>
  </div>
</div>

<h2>Rides</h2>
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-value"><%= stats.totalRides %></div>
    <div class="stat-label">Total rides</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.completedRides %></div>
    <div class="stat-label">Completed rides</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= stats.cancelledRides %></div>
    <div class="stat-label">Cancelled rides</div>
  </div>
</div>

<div class="btn-row">
  <a class="btn btn-primary" href="/admin/users">Manage users</a>
  <a class="btn btn-primary" href="/admin/rides">View all rides</a>
</div>

<%- include('../partials/footer') %>
