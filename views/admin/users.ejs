<%- include('../partials/header') %>

<div class="page-header">
  <h1>Users</h1>
</div>

<table class="table">
  <thead>
    <tr>
      <th>#</th>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
      <th>Status</th>
      <th>Registered</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(function (user) { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td>
          <% if (user.is_active) { %>
            <span class="badge badge-COMPLETED">ACTIVE</span>
          <% } else { %>
            <span class="badge badge-CANCELLED">INACTIVE</span>
          <% } %>
        </td>
        <td><%= helpers.formatDateTime(user.created_at) %></td>
        <td>
          <% if (user.is_active) { %>
            <form method="POST" action="/admin/users/<%= user.id %>/active">
              <input type="hidden" name="active" value="0" />
              <button type="submit" class="btn btn-danger btn-small"
                      data-confirm="Deactivate this user?">Deactivate</button>
            </form>
          <% } else { %>
            <form method="POST" action="/admin/users/<%= user.id %>/active">
              <input type="hidden" name="active" value="1" />
              <button type="submit" class="btn btn-small">Activate</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../partials/footer') %>
