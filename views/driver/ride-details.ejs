<%- include('../partials/header') %>

<div class="page-header">
  <h1>Ride #<%= ride.id %></h1>
  <span id="ride-status-badge" class="badge badge-<%= ride.status %>"><%= ride.status %></span>
</div>

<div class="ride-layout">
  <div class="card">
    <h2>Trip details</h2>
    <table class="table">
      <tbody>
        <tr><th>Passenger</th><td id="ride-driver-info"><%= ride.passenger_name %></td></tr>
        <tr><th>Pickup (origin)</th><td><%= ride.origin %></td></tr>
        <tr><th>Destination</th><td><%= ride.destination %></td></tr>
        <tr><th>Distance</th><td><%= ride.distance_km != null ? ride.distance_km + ' km' : '-' %></td></tr>
        <tr><th>Estimated time</th><td><%= ride.estimated_duration != null ? ride.estimated_duration + ' min' : '-' %></td></tr>
        <tr><th>Estimated price</th><td><strong><%= ride.estimated_price != null ? ride.estimated_price.toLocaleString() + ' تومان' : '-' %></strong></td></tr>
        <tr><th>Requested at</th><td><%= helpers.formatDateTime(ride.created_at) %></td></tr>
        <% if (ride.accepted_at) { %><tr><th>Accepted at</th><td><%= helpers.formatDateTime(ride.accepted_at) %></td></tr><% } %>
        <% if (ride.started_at) { %><tr><th>Started at</th><td><%= helpers.formatDateTime(ride.started_at) %></td></tr><% } %>
        <% if (ride.completed_at) { %><tr><th>Completed at</th><td><%= helpers.formatDateTime(ride.completed_at) %></td></tr><% } %>
      </tbody>
    </table>

    <div class="btn-row" style="margin-top: 12px;">
      <% if (ride.status === 'ACCEPTED') { %>
        <form method="POST" action="/driver/rides/<%= ride.id %>/start">
          <button type="submit" class="btn btn-primary">Start Ride</button>
        </form>
        <form method="POST" action="/driver/rides/<%= ride.id %>/cancel">
          <button type="submit" class="btn btn-danger" data-confirm="Cancel this ride?">Cancel</button>
        </form>
      <% } else if (ride.status === 'STARTED') { %>
        <form method="POST" action="/driver/rides/<%= ride.id %>/complete">
          <button type="submit" class="btn btn-primary">Complete Ride</button>
        </form>
      <% } %>
      <a class="btn" href="/driver/dashboard">Back to dashboard</a>
    </div>
  </div>

  <div class="card map-card">
    <h2>Route</h2>
    <div id="ride-map" class="map-box"></div>
  </div>
</div>

<script type="application/json" id="ride-map-data">
  <%- JSON.stringify({
        mapId: 'ride-map',
        rideId: ride.id,
        poll: ['REQUESTED', 'ACCEPTED', 'STARTED'].includes(ride.status),
        originLat: ride.origin_lat, originLng: ride.origin_lng,
        destinationLat: ride.destination_lat, destinationLng: ride.destination_lng,
        driverLat: driverLocation ? driverLocation.lat : null,
        driverLng: driverLocation ? driverLocation.lng : null,
        driverName: ride.driver_name || null
      }) %>
</script>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="/js/map-utils.js"></script>
<script src="/js/ride-view.js"></script>

<%- include('../partials/footer') %>
