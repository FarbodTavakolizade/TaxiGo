<%- include('../partials/header') %>

<div class="page-header">
  <h1>My Rides</h1>
</div>

<% if (rides.length === 0) { %>
  <div class="empty-state">
    <div class="empty-state-icon">🚗</div>
    <p class="empty-state-title">No rides yet</p>
    <p class="empty-state-text">Rides you accept and complete will be listed here.</p>
    <a class="btn btn-primary" href="/driver/dashboard">See available requests</a>
  </div>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Passenger</th>
        <th>From</th>
        <th>To</th>
        <th>Distance</th>
        <th>Price</th>
        <th>Status</th>
        <th>Requested at</th>
        <th>Completed at</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% rides.forEach(function (ride) { %>
        <tr>
          <td><%= ride.id %></td>
          <td><%= ride.passenger_name %></td>
          <td><%= ride.origin %></td>
          <td><%= ride.destination %></td>
          <td><%= ride.distance_km != null ? ride.distance_km + ' km' : '-' %></td>
          <td><%= ride.estimated_price != null ? ride.estimated_price.toLocaleString() + ' تومان' : '-' %></td>
          <td><%- include('../partials/status-badge', { status: ride.status }) %></td>
          <td><%= helpers.formatDateTime(ride.created_at) %></td>
          <td><%= helpers.formatDateTime(ride.completed_at) %></td>
          <td><a class="btn btn-small" href="/driver/rides/<%= ride.id %>">Details</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
